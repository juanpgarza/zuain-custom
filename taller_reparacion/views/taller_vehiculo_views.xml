<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taller_vehiculo_view_form" model="ir.ui.view">
        <field name="name">taller.vehiculo.form</field>
        <field name="model">taller.vehiculo</field>
        <field name="arch" type="xml">
            <form string="Vehículo">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_reparaciones" type="object" class="oe_stat_button"
                                icon="fa-wrench">
                            <field name="reparacion_count" widget="statinfo" string="Reparaciones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="patente"/>
                        <h1><field name="patente" placeholder="AB123CD"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="marca"/>
                            <field name="modelo"/>
                            <field name="anio" options="{'format': false}"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="taller_vehiculo_view_list" model="ir.ui.view">
        <field name="name">taller.vehiculo.list</field>
        <field name="model">taller.vehiculo</field>
        <field name="arch" type="xml">
            <list string="Vehículos">
                <field name="patente"/>
                <field name="marca"/>
                <field name="modelo"/>
                <field name="anio" options="{'format': false}"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="taller_vehiculo_view_search" model="ir.ui.view">
        <field name="name">taller.vehiculo.search</field>
        <field name="model">taller.vehiculo</field>
        <field name="arch" type="xml">
            <search>
                <field name="patente"/>
                <field name="marca"/>
                <field name="modelo"/>
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="action_taller_vehiculo" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">taller.vehiculo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
