<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taller_reparacion_view_form" model="ir.ui.view">
        <field name="name">taller.reparacion.form</field>
        <field name="model">taller.reparacion</field>
        <field name="arch" type="xml">
            <form string="Orden de trabajo">
                <header>
                    <button name="action_vincular_venta" type="object" string="Pedido de venta"
                            class="btn-primary" invisible="state == 'cancelado'"/>
                    <button name="action_en_proceso" type="object" string="Iniciar"
                            invisible="state != 'borrador'"/>
                    <button name="action_terminado" type="object" string="Terminar"
                            invisible="state != 'en_proceso'"/>
                    <button name="action_entregado" type="object" string="Entregar"
                            invisible="state != 'terminado'"/>
                    <button name="action_cancelar" type="object" string="Cancelar"
                            invisible="state in ('entregado', 'cancelado')"/>
                    <button name="action_borrador" type="object" string="Volver a borrador"
                            invisible="state != 'cancelado'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,en_proceso,terminado,entregado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_pedidos" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Pedidos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehiculo_id" placeholder="Ingresá la patente..."
                                   context="{'default_partner_id': partner_id}"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="fecha_ingreso"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas de reparación" name="notas">
                            <field name="notas_reparacion"
                                   placeholder="Describí el trabajo realizado, repuestos, observaciones..."/>
                        </page>
                        <page string="Pedidos de venta" name="pedidos">
                            <field name="sale_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="taller_reparacion_view_list" model="ir.ui.view">
        <field name="name">taller.reparacion.list</field>
        <field name="model">taller.reparacion</field>
        <field name="arch" type="xml">
            <list string="Órdenes de trabajo">
                <field name="name"/>
                <field name="fecha_ingreso"/>
                <field name="vehiculo_id"/>
                <field name="partner_id"/>
                <field name="sale_order_count" string="Pedidos" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'borrador'"
                       decoration-warning="state == 'en_proceso'"
                       decoration-success="state in ('terminado', 'entregado')"
                       decoration-muted="state == 'cancelado'"/>
            </list>
        </field>
    </record>

    <record id="taller_reparacion_view_search" model="ir.ui.view">
        <field name="name">taller.reparacion.search</field>
        <field name="model">taller.reparacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehiculo_id"/>
                <field name="partner_id"/>
                <filter name="abiertas" string="Abiertas"
                        domain="[('state', 'in', ('borrador', 'en_proceso'))]"/>
                <filter name="terminadas" string="Terminadas"
                        domain="[('state', '=', 'terminado')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_vehiculo" string="Vehículo" context="{'group_by': 'vehiculo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_taller_reparacion" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
        <field name="res_model">taller.reparacion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_abiertas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registrá la primera orden de trabajo del taller</p>
        </field>
    </record>
</odoo>
